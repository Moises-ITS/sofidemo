# Copy to .env and fill in real keys. The server reads these; keys never reach the browser.

# OpenAI — used by /api/analyze for image identification.
# Without it, the server returns a canned mock identification (UI still works).
OPENAI_API_KEY=
# Optional: override the vision model (default: gpt-4o-mini)
OPENAI_MODEL=

# Shopping search — /api/search-product tries SerpAPI first, then Serper.
# Provide at least one. Without either, the app relies on src/data/demoFallbacks.ts.
SERPAPI_API_KEY=
SERPER_API_KEY=

# Optional: API server port (default 3001; the Vite proxy expects 3001)
PORT=
