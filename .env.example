# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Vision — set either or both. VISION_PROVIDER picks when both are set
# (claude | openai); default is claude.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
VISION_PROVIDER=

# Optional model overrides
RECOGNIZE_MODEL=   # Claude model, default claude-opus-5
OPENAI_MODEL=      # OpenAI model, default gpt-4o-mini

# Optional: real retailer prices via SerpAPI Google Shopping (serpapi.com,
# free tier). Leave empty to fall back to the model's price estimate.
SERPAPI_KEY=
